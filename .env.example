# Long Agent 环境变量配置模板
# 复制为 .env 并填入真实值

# === LLM 配置 ===
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# === 数据库 ===
DATABASE_PATH=data/memory.db

# === 数据目录 ===
DATA_DIR=data
BACKUP_DIR=data/backups
BACKUP_KEEP=3

# === 日志 ===
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# === 后台任务 ===
BACKUP_INTERVAL_HOURS=24
SNAPSHOT_CLEANUP_DAYS=7
VACUUM_INTERVAL_DAYS=30

# === Web UI ===
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8080
WEB_UI_RELOAD=true
